<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- H2 — Desenvolvimento e Testes -->
    <persistence-unit name="aisafe-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>enginemodel.domain.EngineModel</class>
        <class>flight.domain.Flight</class>
        <class>flightPlan.domain.FlightPlan</class>
        <class>flightPlan.domain.FlightLeg</class>
        <class>flightPlan.domain.Segment</class>
        <class>flightPlan.domain.AltitudeSlot</class>
        <class>flightRoute.domain.FlightRoute</class>
        <class>node.domain.Node</class>
        <class>aircraft.domain.Aircraft</class>
        <class>pilot.domain.Pilot</class>
        <class>airport.domain.Airport</class>
        <class>user.domain.User</class>
        <class>simulationReport.domain.SimulationReport</class>
        <class>weatherData.domain.WeatherData</class>
        <class>simulation.domain.Simulation</class>
        <class>simulation.domain.AircraftPosition</class>
        <class>simulation.domain.SafetyViolation</class>
        <class>aircraftmodel.domain.AircraftModel</class>
        <class>aircontrolarea.domain.AirControlArea</class>
        <class>airtransportcompany.domain.AirTransportCompany</class>
        <class>eapli.framework.infrastructure.authz.domain.model.SystemUser</class>
        <class>eapli.framework.infrastructure.authz.domain.model.Role</class>
        <class>eapli.framework.infrastructure.authz.domain.model.RoleSet</class>
        <class>eapli.framework.infrastructure.authz.domain.model.RoleAssignment</class>
        <class>customercollaborator.domain.CustomerCollaborator</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"   value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"      value="jdbc:h2:tcp://localhost:9092/mem:aisafe;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;NON_KEYWORDS=USER,VALUE"/>
            <property name="jakarta.persistence.jdbc.user"     value="admin"/>
            <property name="jakarta.persistence.jdbc.password" value="admin"/>

            <property name="hibernate.dialect"                 value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto"            value="update"/>
            <property name="hibernate.format_sql"              value="true"/>
            <property name="hibernate.use_sql_comments"        value="true"/>
            <property name="hibernate.show_sql"                value="false"/>
            <property name="hibernate.generate_statistics"     value="false"/>
            <property name="hibernate.hikari.maximumPoolSize"  value="5"/>
        </properties>
    </persistence-unit>

    <!-- PostgreSQL — Produção -->
    <persistence-unit name="aisafe-pu-postgres" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>enginemodel.domain.EngineModel</class>
        <class>flight.domain.Flight</class>
        <class>flightPlan.domain.FlightPlan</class>
        <class>flightPlan.domain.FlightLeg</class>
        <class>flightPlan.domain.Segment</class>
        <class>flightPlan.domain.AltitudeSlot</class>
        <class>flightRoute.domain.FlightRoute</class>
        <class>node.domain.Node</class>
        <class>aircraft.domain.Aircraft</class>
        <class>pilot.domain.Pilot</class>
        <class>airport.domain.Airport</class>
        <class>user.domain.User</class>
        <class>simulationReport.domain.SimulationReport</class>
        <class>weatherData.domain.WeatherData</class>
        <class>simulation.domain.Simulation</class>
        <class>simulation.domain.AircraftPosition</class>
        <class>simulation.domain.SafetyViolation</class>
        <class>aircraftmodel.domain.AircraftModel</class>
        <class>aircontrolarea.domain.AirControlArea</class>
        <class>airtransportcompany.domain.AirTransportCompany</class>
        <class>customercollaborator.domain.CustomerCollaborator</class>
        <class>eapli.framework.infrastructure.authz.domain.model.SystemUser</class>
        <class>eapli.framework.infrastructure.authz.domain.model.Role</class>
        <class>eapli.framework.infrastructure.authz.domain.model.RoleSet</class>
        <class>eapli.framework.infrastructure.authz.domain.model.RoleAssignment</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"   value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"      value="jdbc:postgresql://localhost:5432/aisafe"/>
            <property name="jakarta.persistence.jdbc.user"     value=""/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect"                 value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto"            value="validate"/>
            <property name="hibernate.format_sql"              value="true"/>
            <property name="hibernate.use_sql_comments"        value="true"/>
            <property name="hibernate.show_sql"                value="true"/>
            <property name="hibernate.generate_statistics"     value="false"/>
            <property name="hibernate.hikari.maximumPoolSize"  value="20"/>
        </properties>
    </persistence-unit>

</persistence>