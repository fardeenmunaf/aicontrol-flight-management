<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafxui.presentation.pilot.CompanyPilotsUI"
      styleClass="root" spacing="0">

    <HBox styleClass="sim-status-bar" alignment="CENTER_LEFT" spacing="16">
        <Label fx:id="pageTitle" text="Company Pilots" styleClass="page-title" style="-fx-padding: 0;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻  Refresh" styleClass="btn-success" onAction="#onRefresh"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="status-label" style="-fx-padding: 8 16 0 16;" text=""/>

    <ListView fx:id="table" VBox.vgrow="ALWAYS" styleClass="card-list"/>

</VBox>
