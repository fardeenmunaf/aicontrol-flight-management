<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafxui.presentation.pilot.CompanyPilotsUI"
      styleClass="root" spacing="0">

    <HBox styleClass="sim-status-bar" alignment="CENTER_LEFT" spacing="16">
        <Label fx:id="pageTitle" text="Company Pilots" styleClass="page-title" style="-fx-padding: 0;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻  Refresh" styleClass="btn-success" onAction="#onRefresh"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="status-label" style="-fx-padding: 8 16 0 16;" text=""/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-padding: 16;">
        <columns>
            <TableColumn fx:id="colEmail"   text="Email"            prefWidth="220"/>
            <TableColumn fx:id="colStatus"  text="Status"           prefWidth="80"/>
            <TableColumn fx:id="colModels"  text="Certified Models" prefWidth="300"/>
            <TableColumn fx:id="colAction"  text="Action"           prefWidth="220"/>
        </columns>
    </TableView>

</VBox>
