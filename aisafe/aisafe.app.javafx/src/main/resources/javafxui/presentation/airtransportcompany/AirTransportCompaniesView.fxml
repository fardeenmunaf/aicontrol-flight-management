<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafxui.presentation.airtransportcompany.AirTransportCompaniesUI"
      styleClass="root" spacing="0">
    <HBox styleClass="sim-status-bar" alignment="CENTER_LEFT" spacing="16">
        <Label text="Air Transport Companies" styleClass="page-title" style="-fx-padding: 0;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Register Company" styleClass="btn-primary" onAction="#onRegister"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="status-label" style="-fx-padding: 8 16 0 16;" text=""/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-padding: 16;">
        <columns>
            <TableColumn fx:id="colName"   text="Name"      prefWidth="300"/>
            <TableColumn fx:id="colIata"   text="IATA Code" prefWidth="120"/>
            <TableColumn fx:id="colIcao"   text="ICAO Code" prefWidth="120"/>
            <TableColumn fx:id="colAction" text="Action"    prefWidth="90"/>
        </columns>
    </TableView>
    <VBox fx:id="registerForm" managed="false" visible="false"
          styleClass="form-panel">
        <Label text="Register Air Transport Company" styleClass="page-title" style="-fx-padding:0 0 8 0;"/>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Company Name"/>
                <TextField fx:id="fName" promptText="e.g. TAP Air Portugal"/></VBox>
            <VBox spacing="4"><Label text="IATA Code (2 letters)"/>
                <TextField fx:id="fIata" promptText="TP" prefWidth="120"/></VBox>
            <VBox spacing="4"><Label text="ICAO Code (2-3 letters)"/>
                <TextField fx:id="fIcao" promptText="TAP" prefWidth="120"/></VBox>
        </HBox>
        <HBox spacing="12">
            <Button text="Save" styleClass="btn-primary" onAction="#onSaveRegister"/>
            <Button text="Cancel" styleClass="btn-danger" onAction="#onCancelRegister"/>
        </HBox>
        <Label fx:id="formError" styleClass="error-label" text="" wrapText="true"/>
    </VBox>
</VBox>
