<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafxui.presentation.aircontrolarea.AirControlAreasUI"
      styleClass="root" spacing="0">
    <HBox styleClass="sim-status-bar" alignment="CENTER_LEFT" spacing="16">
        <Label text="Air Control Areas" styleClass="page-title" style="-fx-padding: 0;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Register Area" styleClass="btn-primary" onAction="#onRegister"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="status-label" style="-fx-padding: 8 16 0 16;" text=""/>
    <ListView fx:id="table" VBox.vgrow="ALWAYS" styleClass="card-list"/>
    <VBox fx:id="registerForm" managed="false" visible="false"
          styleClass="form-panel">
        <Label text="Register Air Control Area" styleClass="page-title" style="-fx-padding:0 0 8 0;"/>
        <HBox spacing="12">
            <VBox spacing="4"><Label text="Area Code"/>
                <TextField fx:id="fCode" promptText="e.g. LPPC" prefWidth="160"/></VBox>
            <VBox spacing="4"><Label text="Min Arrival Fuel (kg)"/>
                <TextField fx:id="fMinFuel" promptText="e.g. 500.0" prefWidth="160"/></VBox>
        </HBox>
        <VBox spacing="4"><Label text="Geographic Boundaries (lat,lon;lat,lon;...)"/>
            <TextField fx:id="fBoundaries" promptText="e.g. 36.0,-9.5;44.0,-9.5;44.0,-6.0;36.0,-6.0"/></VBox>
        <HBox spacing="12">
            <Button text="Save" styleClass="btn-primary" onAction="#onSaveRegister"/>
            <Button text="Cancel" styleClass="btn-danger" onAction="#onCancelRegister"/>
        </HBox>
        <Label fx:id="formError" styleClass="error-label" text="" wrapText="true"/>
    </VBox>
</VBox>
