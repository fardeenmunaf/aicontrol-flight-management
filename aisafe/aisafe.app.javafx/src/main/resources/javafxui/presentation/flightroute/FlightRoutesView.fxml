<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafxui.presentation.flightroute.FlightRoutesUI"
      styleClass="root" spacing="0">

    <HBox styleClass="sim-status-bar" alignment="CENTER_LEFT" spacing="16">
        <Label text="Flight Routes" styleClass="page-title" style="-fx-padding: 0;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⟳ Refresh" styleClass="btn-primary" onAction="#onRefresh"/>
        <Button text="Create Route" styleClass="btn-primary" onAction="#onCreateRoute"/>
    </HBox>

    <Label fx:id="messageLabel" styleClass="status-label" style="-fx-padding: 8 16 0 16;" text=""/>

    <ListView fx:id="routesTable" VBox.vgrow="ALWAYS" styleClass="card-list"/>

    <!-- Create Route Form -->
    <VBox fx:id="createForm" managed="false" visible="false" styleClass="form-panel">
        <Label text="Create New Flight Route (US073)" styleClass="page-title" style="-fx-padding:0 0 8 0;"/>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Designation"/>
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label fx:id="lblPrefix" styleClass="status-label" style="-fx-font-weight:bold;"/>
                    <TextField fx:id="fSuffix" promptText="123" prefWidth="80"/>
                </HBox>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Active From"/>
                <DatePicker fx:id="dpActiveFrom" maxWidth="Infinity"/>
            </VBox>
        </HBox>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Origin Airport"/>
                <ComboBox fx:id="cbOrigin" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Destination Airport"/>
                <ComboBox fx:id="cbDestination" maxWidth="Infinity"/>
            </VBox>
        </HBox>
        <HBox spacing="12">
            <Button text="Save" styleClass="btn-primary" onAction="#onSaveCreate"/>
            <Button text="Cancel" styleClass="btn-danger" onAction="#onCancelCreate"/>
        </HBox>
        <Label fx:id="formError" styleClass="error-label" text="" wrapText="true"/>
    </VBox>
</VBox>
