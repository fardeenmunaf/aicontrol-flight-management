@startuml
skinparam packageStyle rectangle
skinparam shadowing false
hide circle
hide methods

title AlSafe Domain Model - Aggregate Boundaries

' --- AGGREGATES ---

package "User Aggregate" <<Aggregate>> #E6F3FF {
  class User <<Aggregate Root>> {
    email
    name
    phoneNumber
    activeSecurityClearanceExpiry
    skillsAssessmentDueDate
    status
  }


  class Role <<Enum>> {
    designation
  }
}

package "Pilot Aggregate" <<Aggregate>> #EBD6FF {
  class Pilot <<Aggregate Root>> {
    status
  }

  note right of Pilot
    Pilot is managed in its own aggregate and linked
    to Identity & Access through User
  end note
}

package "AirTransportCompany Aggregate" <<Aggregate>> #E6FFE6 {
  class AirTransportCompany <<Aggregate Root>> {
    name
    iataCode
    icaoCode
  }
}

package "AirControlArea Aggregate" <<Aggregate>> #FFFFE6 {
  class AirControlArea <<Aggregate Root>> {
    areaCode
    minimumRequiredArrivalFuel
    geographicBoundaries
  }
}

package "Airport Aggregate" <<Aggregate>> #FFF0E6 {
  class Airport <<Aggregate Root>> {
    name
    town
    country
    iataCode
    icaoCode
    elevation
  }

  class "Coordinates" as AirportCoordinates <<Value Object>> {
    latitude
    longitude
  }
}

package "Node Aggregate" <<Aggregate>> #F0E6FF {
  class Node <<Aggregate Root>> {
    designation
  }

  class "Coordinates" as NodeCoordinates <<Value Object>> {
    latitude
    longitude
  }
}

package "AircraftModel Aggregate" <<Aggregate>> #FFE6E6 {
  class AircraftModel <<Aggregate Root>> {
    modelId
    type
    emptyWeight
    maximumTakeOffWeight
    maximumZeroFuelWeight
    maximumFuelCapacity
    serviceCeiling
    cruiseSpeed
    wingArea
    wingSpan
    dragCoefficient
    liftCoefficient
  }

  class AircraftMaker <<Value Object>> {
    name
    country
  }
}

package "EngineModel Aggregate" <<Aggregate>> #FFDAB9 {
  class EngineModel <<Aggregate Root>> {
    name
    type
    power
    fuelType
    efficiency
    thrustSeaLevelStopped
    thrustSeaLevelCruise
    thrustSpecificFuelConsumption
  }

  class EngineMaker <<Value Object>> {
    name
    country
  }

  class FuelProperties <<Value Object>> {
    type
    density
    specificEnergy
  }
}

package "Aircraft Aggregate" <<Aggregate>> #E6FFFF {
  class Aircraft <<Aggregate Root>> {
    registrationNumber
    registrationCountry
    operationalStatus
    flightCrewCount
  }

  class CabinConfiguration <<Value Object>> {
    firstClassSeats
    businessClassSeats
    economyClassSeats
  }

  note right of CabinConfiguration
    Modeled as a Value Object intrinsically tied
    to the lifecycle of a specific Aircraft
  end note
}

package "FlightRoute Aggregate" <<Aggregate>> #FFE6F0 {
  class FlightRoute <<Aggregate Root>> {
    designation
    activeFrom
    activeUntil
  }

}

package "Flight Aggregate" <<Aggregate>> #E6FFF0 {
  class Flight <<Aggregate Root>> {
    flightDesignator
    type
    scheduledDepartureTime
    scheduledArrivalTime
  }

}

package "FlightPlan Aggregate" <<Aggregate>> #FFF5E6 {
  class FlightPlan <<Aggregate Root>> {
    departureDateTime
    fuelQuantity
    passengerLoad
    cargoLoad
    status
  }

  note right of FlightPlan
    Acts as the execution blueprint, coordinating
    the routing (FlightLeg), Aircraft, and Pilot allocation
  end note

  class FlightLeg <<Entity>> {
    sequenceNumber
    departureTime
    arrivalTime
    fuelQuantity
  }

  class Segment <<Entity>> {
    windDirection
    windSpeed
  }

  note bottom of Segment
    Segment is part of Flight Plan Aggregate because it has a composition relation with FlightLeg
  end note

  class AltitudeSlot <<Entity>> {
    minimumAltitude
    maximumAltitude
    width
  }
}

package "Simulation Aggregate" <<Aggregate>> #E6E6FF {
  class Simulation <<Aggregate Root>> {
    startDateTime
    endDateTime
    geographicArea
    safetyThresholds
    performanceSettings
    status
  }

  class AircraftPosition <<Entity>> {
    timestamp
    altitude
  }

  class VelocityVector <<Value Object>> {
    speed
    direction
  }

  note right of VelocityVector
    Value Object capturing the instantaneous
    movement state of an aircraft during simulation
  end note

  class SafetyViolation <<Entity>> {
    timestamp
    severity
  }
}

package "WeatherData Aggregate" <<Aggregate>> #EAF2F8 {
  class WeatherData <<Aggregate Root>> {
    date
    windSpeed
    windDirection
  }
}

package "SimulationReport Aggregate" <<Aggregate>> #D6EAF8 {
  class SimulationReport <<Aggregate Root>> {
    totalFlights
    validationResult
    generatedAt
  }
}

' --- RELATIONSHIPS (Cross-Aggregate and Internal) ---

' Identity
User "1..*" --> "0..*" Role : assigned >
Pilot "1" --> "1" User : account id >

' Topography internal
Airport "1" *-- "1" AirportCoordinates : located at >
Node "1" *-- "1" NodeCoordinates : located at >
Airport "0..*" --> "1" AirControlArea : control area id >

' Cross-Aggregate: Company Operations
AirTransportCompany "1" --> "0..*" User : employs >
AirTransportCompany "1" --> "0..*" FlightRoute : operates >
AirTransportCompany "1" --> "0..*" Aircraft : owns >

' Engine Catalog internal
EngineModel "1" *-- "1" FuelProperties : defined by >
EngineModel "1" *-- "1" EngineMaker : made by >

' Cross-Aggregate: Aircraft-Engine Compatibility
AircraftModel "1..*" --> "1..*" EngineModel : supports >
AircraftModel "1" *-- "1" AircraftMaker : made by >

' Cross-Aggregate: Pilot Certifications
Pilot "0..*" --> "1..*" AircraftModel : certified for >

' Fleet internal
Aircraft "1" *-- "1" CabinConfiguration : configured with >

' Cross-Aggregate: Fleet to Catalog
Aircraft "0..*" --> "1" AircraftModel : is of type >

' Flight Planning internal & cross-aggregate
FlightRoute "1" --> "0..*" Flight : schedules >
Flight "1" --> "0..*" FlightPlan : uses >
FlightPlan "1" *-- "1..*" FlightLeg : composed of >
FlightLeg "1" *-- "1..*" Segment : follows >
Segment "1" *-- "1..*" AltitudeSlot : contains >

' Cross-Aggregate: Flight Planning connections
FlightPlan "0..*" --> "1" Aircraft : assigns >
FlightPlan "0..*" --> "1" Pilot : assigns pilot >
FlightLeg "1" --> "1" Airport : departure id >
FlightLeg "1" --> "1" Airport : arrival id >
Segment "1" --> "1" Node : start node id >
Segment "1" --> "1" Node : end node id >

' Simulation internal
Simulation "1" *-- "0..*" AircraftPosition : generates >
Simulation "1" *-- "0..*" SafetyViolation : detects >
Simulation "1" --> "0..*" WeatherData : captures >
AircraftPosition "1" *-- "1" VelocityVector : includes >
SafetyViolation "1" *-- "2..*" VelocityVector : records vectors >
AircraftPosition "0..*" --> "1" Aircraft : aircraft id >
SafetyViolation "0..*" --> "2..*" Aircraft : involved aircraft ids >


' Simulation reporting (separate lifecycle)
SimulationReport "1" --> "1" Simulation : for simulation >

' Cross-Aggregate: Simulation connections
Simulation "1" --> "1" AirControlArea : runs in >
Simulation "1" --> "1..*" Flight : tracks >

@enduml